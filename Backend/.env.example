# MongoDB Atlas password for user "Arghadeep" (see Backend/models/db.js — cluster host and username are hardcoded there)
MONGODB_PASSWORD=

# AWS S3 credentials, used to generate pre-signed upload URLs for images (GET /s3URL)
ACCESS_KEYID=
SECRET_ACCESS_KEY=
REGION=
BUCKET_NAME=

# Mapbox API token, used server-side for forward geocoding restaurant addresses (POST /uploadRestaurant)
MAPBOX_TOKEN=

# Secret used to sign and verify restaurant-owner JWTs (POST /restaurantLogin, middleware/auth.js). Generate with: openssl rand -hex 32
JWT_SECRET=
